# ============================================================
# Compliance Document Review - Environment Configuration
# ============================================================

# Application
PROJECT_NAME="Compliance Document Review API"
API_V1_STR="/api/v1"

# Security
# DEVELOPMENT PLACEHOLDER ONLY.
# Generate a strong random value for production.
SECRET_KEY="CHANGE-ME-IN-PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# PostgreSQL / pgvector
# ============================================================

DATABASE_URL="postgresql://compliance_user:change-me@localhost:5433/compliance_db"

# ============================================================
# Document Storage
# ============================================================

UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# ============================================================
# AI / LLM
# ============================================================

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30

# ============================================================
# Vector Retrieval
# ============================================================

DISCLOSURE_ABSENCE_THRESHOLD=0.60
PRECEDENT_TOP_K=3
RULE_RETRIEVAL_TOP_K=5
